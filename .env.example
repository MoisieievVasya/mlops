# newsflow — local stack configuration.
# Copy to .env and fill in. .env is gitignored and never committed (design 6.4).
#   cp .env.example .env

# --- object store (MinIO-compatible, pgsty/silo) --------------------------------
MINIO_ROOT_USER=newsflow
MINIO_ROOT_PASSWORD=newsflow-local-dev
# The same credentials under their S3 names: DVC, MLflow and boto3 all read these.
AWS_ACCESS_KEY_ID=newsflow
AWS_SECRET_ACCESS_KEY=newsflow-local-dev
AWS_DEFAULT_REGION=us-east-1
# Seen from the laptop. Inside the compose network the endpoint is http://minio:9000.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9100
DVC_S3_ENDPOINT_URL=http://localhost:9100

# --- warehouse ------------------------------------------------------------------
POSTGRES_USER=newsflow
POSTGRES_PASSWORD=newsflow-local-dev
POSTGRES_HOST_PORT=5433
# Seen from the laptop; inside the compose network it is postgres:5432.
NEWSFLOW_DSN=postgresql://newsflow:newsflow-local-dev@localhost:5433/newsflow

# --- tracking server ------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5001
# MLflow 3 hands the client presigned URLs that name the store as the *server* sees
# it (http://minio:9000), which does not resolve from the laptop and makes
# load_model hang in retries. This routes artifact traffic through the server.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false

# --- application secrets --------------------------------------------------------
# Salt for the author byline hash (design 6.5: no plaintext author leaves the raw
# layer). Changing it changes the author_hash key, so it is pinned per environment.
NEWSFLOW_AUTHOR_SALT=newsflow-local-salt

# --- host ports (changed only if something already listens on them) ---------------
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
AIRFLOW_PORT=8080
MLFLOW_PORT=5001
