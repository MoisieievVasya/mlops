# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Environment
.env
.env.local

# Data: the bytes belong to DVC and the remote, the pointers belong to Git.
# `data/raw/news_category_v3.json` is ignored; `...json.dvc`, which names its hash,
# is committed and is what a reviewer clones (design 6.1, mark 1).
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitignore
*.parquet
*.csv
*.json.gz

# DVC local state: the remote's credentials live here and are never committed.
/.dvc/config.local
/.dvc/tmp
/.dvc/cache

# Local service state
mlruns/
minio-data/
airflow-home/

# Editors / OS
.idea/
.vscode/
.DS_Store
